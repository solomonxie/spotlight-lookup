{
  "expo": {
    "name": "Spotlight Lookup",
    "slug": "spotlight-lookup",
    "scheme": "spotlightlookup",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solomonxie.spotlightlookup",
      "infoPlist": {
        "CFBundleDisplayName": "Lookup"
      }
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
